# Local development only. Replace every password/token before use outside your machine.
POSTGRES_DB=income_assistant
POSTGRES_USER=data_ai
POSTGRES_PASSWORD=change-this-local-db-password
POSTGRES_PORT=5432
API_PORT=8001
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-service-token
# JSON map of active signing key IDs to random secrets (each secret >= 32 bytes).
# Example: {"backend-2026-01":"replace-with-32-byte-minimum-random-secret"}
SERVICE_ASSERTION_KEYS={}
SERVICE_ASSERTION_MAX_SKEW_SECONDS=120
SERVICE_ASSERTION_ISSUER=spring-boot-backend
SERVICE_ASSERTION_AUDIENCE=data-ai
MAX_SIGNED_REQUEST_MB=24
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=change-this-pgadmin-password
PGADMIN_PORT=5050

# Used when running uvicorn on the host instead of Docker Compose.
# For Docker Compose use host=postgres. For host-run uvicorn use host=localhost.
DATABASE_URL=postgresql+psycopg://data_ai:change-this-local-db-password@postgres:5432/income_assistant?options=-csearch_path%3Ddata_ai
# Production/staging must add &sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
STORAGE_DIR=./storage
EXPORT_DIR=./exports
MAX_FILE_MB=20
MAX_FILES_PER_CASE=10
MAX_PDF_PAGES=60
MAX_CSV_ROWS=3000
OCR_LANG=vie+eng
EXPORT_MAX_ROWS_PER_SHEET=50000

APP_ENV=development

# Bounded PostgreSQL connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# Optional request idempotency for POST/PUT/PATCH/DELETE; clients reuse a key on retry.
IDEMPOTENCY_TTL_HOURS=72
IDEMPOTENCY_MAX_REQUEST_MB=24
IDEMPOTENCY_MAX_RESPONSE_KB=1024
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=1800

# V9.5.2: configure a private ClamAV daemon; no scanner means files remain untrusted.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
CLAMAV_CHUNK_KB=64

# Production-only deployment contracts. These values attest that the mounted
# storage/export volumes are encrypted by the platform KMS; DATA-AI does not
# implement application-level encryption itself.
STORAGE_ENCRYPTION_PROVIDER=PLATFORM_MANAGED_KMS
STORAGE_ENCRYPTION_KEY_REFERENCE=replace-with-storage-kms-key-reference
EXPORT_ENCRYPTION_PROVIDER=PLATFORM_MANAGED_KMS
EXPORT_ENCRYPTION_KEY_REFERENCE=replace-with-export-kms-key-reference
REQUIRED_FLYWAY_VERSION=18
MAX_REQUEST_BODY_MB=28

# V10.0: production OCR is blocked until Backend/SSO sends a signed in-scope + consent-granted attestation.
REQUIRE_SCOPE_CONSENT=true
