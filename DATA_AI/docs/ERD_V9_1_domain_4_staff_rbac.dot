digraph ERD {
graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=1.1, fontname="Arial", label="DATA_AI V9.1 | Domain 4: domain 4 staff rbac", labelloc=t, fontsize=18];
node [shape=plain, fontname="Arial"];
edge [color="#64748b", arrowsize=0.65, fontname="Arial", fontsize=8];
"bank_organizations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>bank_organizations</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
"bank_branches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>bank_branches</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">bank_id</TD></TR></TABLE>>];
"staff_users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>staff_users</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">bank_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">branch_id</TD></TR></TABLE>>];
"access_roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>access_roles</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
"staff_user_roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>staff_user_roles</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">staff_user_id</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">role_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">assigned_by</TD></TR></TABLE>>];
"permissions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>permissions</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD></TR></TABLE>>];
"role_permissions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>role_permissions</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">role_id</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">permission_id</TD></TR></TABLE>>];
"staff_role_assignment_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>staff_role_assignment_history</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">staff_user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">role_id</TD></TR></TABLE>>];
"management_audit_logs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>management_audit_logs</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">bank_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">actor_staff_id</TD></TR></TABLE>>];
"bank_organizations" -> "bank_branches" [label="bank_id"];
"bank_organizations" -> "staff_users" [label="bank_id"];
"bank_branches" -> "staff_users" [label="branch_id"];
"staff_users" -> "staff_user_roles" [label="staff_user_id"];
