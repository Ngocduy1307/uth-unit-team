# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# Copy file này thành .env và điều chỉnh thông số phù hợp với máy cá nhân của bạn
# File .env sẽ được .gitignore bỏ qua, không làm ảnh hưởng đến cấu hình chung của team
# ==============================================================================

# PostgreSQL 16 (Docker Compose)
POSTGRES_DB=affordability_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Camunda 8 Zeebe Broker (Docker Compose)
ZEEBE_PORT=26500
ZEEBE_MANAGEMENT_PORT=9600

# Backend Service
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/affordability_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
ZEEBE_GATEWAY_ADDRESS=localhost:26500

# Python AI Service
AI_SERVICE_URL=http://localhost:8000
